[Unit]
Description=Aegis Linux Security Monitor
After=network.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/local/bin/aegis watch --foreground
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
User=root

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/.aegis /etc/aegis
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

# Allow necessary capabilities
AmbientCapabilities=CAP_NET_ADMIN CAP_DAC_READ_SEARCH CAP_KILL CAP_NET_BIND_SERVICE

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aegis

[Install]
WantedBy=multi-user.target
