#!/bin/sh
set -e

AEGIS=/usr/local/bin/aegis

mkdir -p /root/.aegis
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload
fi

# $2 is set to the old version on upgrade, empty on fresh install
if [ -n "$2" ]; then
    # Upgrade: merge new config options, restart service
    echo ""
    echo "  Aegis upgraded (${2} -> $($AEGIS --version 2>/dev/null || echo 'new'))."

    # Backup config before upgrade merge, restore on failure, clean up on success
    if [ -f /etc/aegis/aegis.toml ]; then
        cp /etc/aegis/aegis.toml /etc/aegis/aegis.toml.bak
    fi

    if upgrade_err=$($AEGIS config-upgrade 2>&1); then
        echo "  Config merge: OK"
    else
        echo "  WARN: config-upgrade failed: $upgrade_err"
        if [ -f /etc/aegis/aegis.toml.bak ]; then
            cp /etc/aegis/aegis.toml.bak /etc/aegis/aegis.toml
            echo "  Restored config from backup."
        fi
    fi
    rm -f /etc/aegis/aegis.toml.bak

    if systemctl is-enabled --quiet aegis 2>/dev/null; then
        systemctl try-restart aegis
        echo "  Service restarted. Blocked IPs and config preserved."
    else
        echo "  Service not enabled. Start with: sudo systemctl enable --now aegis"
    fi
    echo ""
else
    # Fresh install
    if [ -f /etc/aegis/.init_done ]; then
        # Init was already run (e.g. user ran aegis init before installing the .deb)
        systemctl enable --now aegis 2>/dev/null || true
        echo ""
        echo "  Aegis installed and started."
        echo "  Config: /etc/aegis/aegis.toml"
        echo ""
    else
        echo ""
        echo "  Aegis installed. Next steps:"
        echo "    1. sudo aegis init                     (first-time system hardening)"
        echo "    2. sudo systemctl enable --now aegis   (start the daemon)"
        echo "  Config: /etc/aegis/aegis.toml"
        echo ""
        echo "  Do NOT run 'aegis init' on upgrades — it is only for first-time setup."
        echo ""
    fi
fi
